$C = "../Common.ui";
$C.@PageOverlay {}
$C.@Container {
  Anchor: (Width: 900, Height: 720);
  #Title { $C.@Title { @Text = "Arcane Core"; } }
  #Content {
    LayoutMode: Top;
    Label #State { Anchor: (Height: 36); Style: ( ...$C.@DefaultLabelStyle, HorizontalAlignment: Center ); }
    Group {
      Anchor: (Height: 510); LayoutMode: Center;
      Group { Anchor: (Width: 784, Height: 510);
      Group { Anchor: (Left: 360, Top: 0, Width: 64, Height: 64); Background: "Icons/AdvancedStorage_Arcane_Core.png"; }
      Label #CoreCount { Anchor: (Left: 242, Top: 68, Width: 300, Height: 28); Style: ( ...$C.@DefaultLabelStyle, HorizontalAlignment: Center ); }
      Group { Anchor: (Left: 391, Top: 100, Width: 2, Height: 24); Background: $C.@ColorCaptionLight; }
      Group { Anchor: (Left: 360, Top: 128, Width: 64, Height: 64); Background: "Icons/AdvancedStorage_Runic_Conduit.png"; }
      Label #Conduits { Anchor: (Left: 242, Top: 196, Width: 300, Height: 28); Style: ( ...$C.@DefaultLabelStyle, HorizontalAlignment: Center ); }
      Group { Anchor: (Left: 391, Top: 228, Width: 2, Height: 24); Background: $C.@ColorCaptionLight; }
      Group { Anchor: (Left: 100, Top: 252, Width: 584, Height: 2); Background: $C.@ColorCaptionLight; }
      Group { Anchor: (Left: 100, Top: 254, Width: 2, Height: 24); Background: $C.@ColorCaptionLight; }
      Group { Anchor: (Left: 684, Top: 254, Width: 2, Height: 24); Background: $C.@ColorCaptionLight; }
      Group { Anchor: (Left: 392, Top: 254, Width: 2, Height: 24); Background: $C.@ColorCaptionLight; }
      Group { Anchor: (Left: 68, Top: 282, Width: 64, Height: 64); Background: "Icons/AdvancedStorage_Seal_Archive.png"; }
      Label #Archives { Anchor: (Left: 0, Top: 352, Width: 200, Height: 28); Style: ( ...$C.@DefaultLabelStyle, HorizontalAlignment: Center ); }
      Group { Anchor: (Left: 100, Top: 384, Width: 2, Height: 24); Background: $C.@ColorCaptionLight; }
      Group { Anchor: (Left: 68, Top: 414, Width: 64, Height: 64); Background: "Icons/AdvancedStorage_Archive_Item_Gate.png"; }
      Label #ItemGates { Anchor: (Left: 0, Top: 482, Width: 200, Height: 28); Style: ( ...$C.@DefaultLabelStyle, HorizontalAlignment: Center ); }
      Group { Anchor: (Left: 360, Top: 282, Width: 64, Height: 64); Background: "Icons/AdvancedStorage_Runic_Catalog.png"; }
      Label #Catalogs { Anchor: (Left: 292, Top: 352, Width: 200, Height: 28); Style: ( ...$C.@DefaultLabelStyle, HorizontalAlignment: Center ); }
      Group { Anchor: (Left: 652, Top: 282, Width: 64, Height: 64); Background: "Icons/AdvancedStorage_Archive_Transmitter.png"; }
      Label #Transmitters { Anchor: (Left: 574, Top: 352, Width: 220, Height: 28); Style: ( ...$C.@DefaultLabelStyle, HorizontalAlignment: Center ); }
      Group { Anchor: (Left: 392, Top: 384, Width: 2, Height: 24); Background: $C.@ColorCaptionLight; }
      ItemIcon #BenchIcon { Anchor: (Left: 360, Top: 414, Width: 64, Height: 64); ShowItemTooltip: false; }
      Label #Benches { Anchor: (Left: 282, Top: 482, Width: 220, Height: 28); Style: ( ...$C.@DefaultLabelStyle, HorizontalAlignment: Center ); }
      Group { Anchor: (Left: 684, Top: 384, Width: 2, Height: 24); Background: $C.@ColorCaptionLight; }
      Group { Anchor: (Left: 652, Top: 414, Width: 64, Height: 64); Background: "Icons/AdvancedStorage_Travelers_Catalog.png"; }
      Label #Travelers { Anchor: (Left: 574, Top: 482, Width: 220, Height: 28); Style: ( ...$C.@DefaultLabelStyle, HorizontalAlignment: Center ); }
    }
      }
    Label #Storage { Anchor: (Height: 32); Style: ( ...$C.@DefaultLabelStyle, HorizontalAlignment: Center ); }
    Label { Text: "Connected network overview"; Anchor: (Height: 26); Style: ( ...$C.@DefaultLabelStyle, HorizontalAlignment: Center ); }
  }
}
$C.@BackButton {}
